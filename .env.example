# Variables de entorno del proyecto. Copiar a .env y ajustar.
#
#   cp .env.example .env
#
# .env NO se versiona: cada maquina tiene la suya.

# Interfaz Ethernet conectada al robot. Solo hace falta para el perfil `real`.
# Para averiguarla:  ./env/go2_net.sh detect
# En el ProBook de desarrollo es enp3s0; en otra maquina puede ser eno1,
# eth0, o enx<mac> si se usa un adaptador USB.
GO2_IFACE=

# Modo por defecto del perfil `dev`: sim o real
GO2_MODE=sim
