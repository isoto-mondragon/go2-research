# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Entornos y credenciales ---
.env
*.pem
*.key

# --- ROS2 / colcon ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# --- Pesos y datos: van por DVC, NUNCA por git ---
*.pt
*.pth
*.onnx
*.ckpt
*.npz
*.bag
*.db3
*.mcap

# --- Salidas de experimentos ---
# Se versiona la METADATA (manifest.json, config.snapshot.yaml, metrics.csv)
# y se ignora todo lo pesado. Los .dvc SI se versionan.
experiments/**/checkpoints/
experiments/**/rosbag/
experiments/**/video/
!experiments/**/*.dvc

# --- Figuras: se regeneran, no se versionan ---
results/figures/*
!results/figures/.gitkeep

# --- LaTeX ---
papers/**/*.aux
papers/**/*.log
papers/**/*.out
papers/**/*.bbl
papers/**/*.blg
papers/**/*.synctex.gz

# --- Sistema ---
.DS_Store
audit_*.txt

# --- Politica de referencia ---
# EXCEPCION deliberada a la regla "los pesos van por DVC".
#
# Esta politica (748 KB) es la UNICA que hace falta para que el simulador haga
# algo nada mas clonar. Con DVC habria que configurar un remote y autenticarse
# antes de empezar, y eso rompe la guia rapida.
#
# La regla sigue en pie para los checkpoints de ENTRENAMIENTO, que pesan
# cientos de MB: esos van por DVC.
#
# Git NO desciende a un directorio excluido, asi que hay que reabrir la ruta
# nivel a nivel antes de poder reincluir el fichero.
!experiments/uc01_locomotion/legacy_wsl2/checkpoints/
!experiments/uc01_locomotion/legacy_wsl2/checkpoints/policy.onnx

# --- Basura del contenedor ---
# Al arrancar con el uid del anfitrion, el HOME del contenedor es /workspace y
# escribe aqui su historial y sus cachés.
.bash_history
.cache/
.config/
.local/
